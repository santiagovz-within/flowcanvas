# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Fal.AI
FAL_KEY=your-fal-api-key
# ADMIN-scoped key used by the account billing API. Falls back to FAL_KEY when omitted.
FAL_ADMIN_KEY=your-fal-admin-api-key

# Google AI
GOOGLE_AI_API_KEY=your-google-api-key

# Google Cloud Storage
# Bucket where generated images/videos and uploads are stored (default: within-glide)
GCS_BUCKET_NAME=within-glide
# Full service-account JSON key — paste the entire contents of your JSON key file.
# Literal \n sequences in private_key are handled automatically.
GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Email (Resend) — notifies admins when a new user requests access.
# Leave unset to disable emails; login still works.
RESEND_API_KEY=re_...
# Must be a verified sender/domain in Resend.
EMAIL_FROM=WITHIN Glide <glide@within.co>
# Public URL of the deployed app, used to build links inside emails (no trailing slash).
# Falls back to the origin of the sign-in request when unset.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
